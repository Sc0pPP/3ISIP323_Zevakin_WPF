<Page x:Class="WpfApp7.Pages.FirstPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FirstPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <TextBox Grid.Row="0" Width="400" x:Name="Search" Height="25" HorizontalAlignment="Left" TextChanged="TextBox_TextChanged"/>
            <Button Content="Регистрация" Grid.Row="0" Width="72" Margin="10" Click="Button_Click"/>
            <Button Content="Сортировка по рейтингу" FontSize="5" Grid.Row="0" Width="70" Margin="10" Click="Button_Click_2"/>
            <Button Content="Сортировка по названию" FontSize="5" Grid.Row="0" Width="70" Margin="10" Click="Button_Click_3"/>
            <Button Content="Личный кабинет" FontSize="7" Grid.Row="0" Width="70" Margin="10" Click="Button_Click_1"/>

        </StackPanel>
        <ListBox Grid.Row="1" x:Name="prod" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source= "{Binding URL}" Width="100" Height="125"/>
                        <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="TxtAbout" Text="{Binding MovieName}"/>
                        <TextBlock  Text="{Binding Rating}"/>
                        <TextBlock  Text="{Binding Description}"/>
                        <TextBlock  Text="{Binding AgeRating}"/>
                        </StackPanel>
                        </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
