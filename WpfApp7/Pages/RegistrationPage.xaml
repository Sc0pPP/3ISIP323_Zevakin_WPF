<Page x:Class="WpfApp7.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrationPage">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
            <TextBlock Text="Регистрация" FontSize="25" HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <TextBlock Text="Имя пользователя" Margin="10,0,10,0"/>
            <TextBox x:Name="UserName" Height="35" Margin="10" />
            <TextBlock Text="Пароль" Margin="10,0,10,0"/>
            <TextBox x:Name="UserPassword" Height="35" Margin="10"/>

            <TextBlock Text="Повторите пароль" Margin="10,0,10,0"/>
            <TextBox x:Name="PasswordProv" Height="35" Margin="10"/>

            <Button Content="Зарегистрироваться" Height="40" Margin="0 0 0 10" Click="Button_Click"/>

            <TextBlock HorizontalAlignment="Center">
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
