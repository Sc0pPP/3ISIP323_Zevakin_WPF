<Page x:Class="WpfApp7.pages.Credit"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Credit">

    <Grid>
        <Grid.RowDefinitions>
        <RowDefinition Height="120"/>
        <RowDefinition Height="120"/>
        <RowDefinition Height="120"/>
        <RowDefinition Height="120"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="50" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Введите первоначальный взнос по кредиту" Width="auto"/>
            <TextBox x:Name="vznos" Width="100" Height="20" Margin="100,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="50" Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Введите срок кредита" Width="auto"/>
            <TextBox x:Name="srok" Width="100" Height="20" Margin="220,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="50" Grid.Row="2" VerticalAlignment="Center">
            <TextBlock x:Name="perv" Text="первоначальный взнос"/>
            <TextBlock x:Name="summ" Text="Сумма в кредит" Margin="60,0"/>
            <TextBlock x:Name="platezh" Text="платеж" Margin="60,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="50" Grid.Row="3" VerticalAlignment="Center">
            <Button Content="Рассчитать кредит" Margin="80,0" Click="Button_Click"/>
            <Button Content="далее" Margin="250,0" Width="50" Click="Button_Click_1" />
        </StackPanel>
    </Grid>
</Page>
