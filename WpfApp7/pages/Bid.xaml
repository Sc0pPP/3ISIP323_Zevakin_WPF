<Page x:Class="WpfApp7.pages.Bid"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Bid">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="30" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Введите ваше ФИО"/>
            <TextBox x:Name="FIO" Width="200" Margin="100,0" TextChanged="FIO_TextChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="30" Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Введите ваш телефон"/>
            <TextBox x:Name="phone" Width="200" Margin="100,0" PreviewTextInput="phone_OnPreviewTextInput"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="30" Grid.Row="2" VerticalAlignment="Center">
            <TextBlock Text="Введите вашу почту"/>
            <TextBox x:Name="pochta" Width="200" Margin="100,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="30" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="Подать Заявку" Click="Button_Click"/>
        </StackPanel>

    </Grid>
</Page>
