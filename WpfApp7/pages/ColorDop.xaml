<Page x:Class="WpfApp7.pages.ColorDop"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp7.pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ColorDop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Выберете цвет" />
            <ComboBox x:Name="type_car" Width="100" Height="50" SelectionChanged="type_car_SelectionChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal"  Grid.Row="1">
            <TextBlock Text="Выберете тип двигателя" />
            <ComboBox x:Name="type_engine" Width="100" Height="50" SelectionChanged="type_engine_SelectionChanged"/>
        </StackPanel>
        <Button Content="Далее" Width="100" Height="50" Grid.Row="1" VerticalAlignment="Bottom" Click="Button_Click"/>
    </Grid>
</Page>
