<Window x:Class="WpfApp7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp7"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900">
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">
                <TextBlock x:Name="TitleTextBlock" Margin="5" VerticalAlignment="Center"/>
                <Button x:Name="BackButton" Grid.Row="0" Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BackButton_OnClick"/>
            </StackPanel>
            <Frame x:Name="MainFrame" Grid.Row="1" Source="Pages/FirstPage.xaml" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
